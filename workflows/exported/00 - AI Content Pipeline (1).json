    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\n\nconst cleaned = raw\n  .replace(/^```json\\s*/i, \"\")\n  .replace(/```$/i, \"\")\n  .trim();\n\nconst posts = JSON.parse(cleaned);\n\nreturn posts.map(post => ({\n  json: {\n    Date: new Date().toISOString(),\n    Topic: post.seoTitle,\n    Platform: post.platform,\n    Title: post.title,\n    Hook: post.hook,\n    Content: post.body,\n    CTA: post.CTA,\n    Hashtags: post.hashtags,\n    \"Image Prompt\": post.imagePrompt,\n    \"Video Prompt\": post.videoPrompt,\n    Status: \"Draft\"\n  }\n}));"
      },
